# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
RADAR_APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=false
ENABLE_EXTENSION_DEV=true
ENABLE_NATIVE_VC_INTEGRATIONS=false
RADAR_EXTENSION_ORIGIN=chrome-extension://jhjclgndbjlnnagdnphjdojinaaodeon
RADAR_DEFAULT_WORKSPACE_ID=radar

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/radar
REDIS_URL=redis://localhost:6379
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_me_public
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me_public
SUPABASE_SECRET_KEY=replace_me_server_only
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=replace_me_local_or_vercel_secret
SUPABASE_AUTH_SMTP_HOST=replace_me_optional
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=replace_me_optional
SUPABASE_AUTH_SMTP_PASS=replace_me_optional
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=hello@example.com
SUPABASE_AUTH_SMTP_SENDER_NAME=Radar

# OpenAI server-side only. Never expose this to browser or extension code.
OPENAI_API_KEY=replace_me
OPENAI_PROJECT_ID=replace_me_optional
OPENAI_REALTIME_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RADAR_RAG_MIN_SIMILARITY=0.55
OPENAI_REGION=replace_me_if_using_regional_endpoint
OPENAI_SAFETY_IDENTIFIER=replace_with_hashed_user_or_tenant_identifier

# shadcn.io MCP local-only; do not commit real tokens.
SHADCNIO_TOKEN=replace_me_local_only
SHADCNIO_BEARER=Bearer ${SHADCNIO_TOKEN}

# Auth
AUTH_SECRET=replace_me
AUTH_URL=http://localhost:3000
RADAR_AUTH_PASSWORD=replace_me
RADAR_LOCAL_AUTH_PASSWORD=replace_me_local_only
RADAR_AUTH_ALLOWED_EMAILS=admin@example.com
RADAR_AUTH_SESSION_TTL_SECONDS=28800

# Bootstrap admin role for emails listed in RADAR_AUTH_ALLOWED_EMAILS.
RADAR_ADMIN_ROLE=admin

# Storage
S3_BUCKET=replace_me
S3_REGION=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# Billing
STRIPE_SECRET_KEY=replace_me_optional
STRIPE_WEBHOOK_SECRET=replace_me_optional
