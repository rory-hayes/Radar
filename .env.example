# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_DEMO_MODE=false
ENABLE_EXTENSION_DEV=true
ENABLE_NATIVE_VC_INTEGRATIONS=false

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/radar
REDIS_URL=redis://localhost:6379

# OpenAI server-side only. Never expose this to browser or extension code.
OPENAI_API_KEY=replace_me
OPENAI_PROJECT_ID=replace_me_optional
OPENAI_REALTIME_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_CLIENT_SECRET_TTL_SECONDS=600
OPENAI_REGION=replace_me_if_using_regional_endpoint
OPENAI_SAFETY_IDENTIFIER=replace_with_hashed_user_or_tenant_identifier

# shadcn.io MCP local-only; do not commit real tokens.
SHADCNIO_TOKEN=replace_me_local_only
SHADCNIO_BEARER=Bearer ${SHADCNIO_TOKEN}

# Auth
AUTH_SECRET=replace_me
AUTH_URL=http://localhost:3000

# Storage
S3_BUCKET=replace_me
S3_REGION=replace_me
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# Billing
STRIPE_SECRET_KEY=replace_me_optional
STRIPE_WEBHOOK_SECRET=replace_me_optional
