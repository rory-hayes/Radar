# Radar local/Codex environment placeholders.
# Copy to .env.local or configure these in your deployment/Codex environment.
# Never commit real secrets.

# shadcn.io MCP Pro access.
# User-provided token belongs here locally, not in repo files.
SHADCNIO_TOKEN=""
SHADCNIO_BEARER="Bearer ${SHADCNIO_TOKEN}"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# OpenAI
OPENAI_API_KEY=""

# Trigger.dev
TRIGGER_SECRET_KEY=""

# Langfuse internal observability
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL=""

# Resend
RESEND_API_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PostHog / Sentry
NEXT_PUBLIC_POSTHOG_KEY=""
SENTRY_AUTH_TOKEN=""
